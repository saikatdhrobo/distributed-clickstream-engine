# Published ports bind only to localhost by default.
APP_PORT=5000
APP_HOST_BIND=127.0.0.1
KAFKA_EXTERNAL_PORT=9094
REDIS_EXTERNAL_PORT=6379

# Kafka topic and consumer settings
KAFKA_TOPIC=clickstream.events
KAFKA_DLQ_TOPIC=clickstream.events.dead-letter
KAFKA_TOPIC_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
KAFKA_CONSUMER_GROUP=clickstream-analytics-v1

# Analytics windows and retention
ANALYTICS_KEY_PREFIX=analytics
BUCKET_SECONDS=10
SERIES_BUCKETS=60
ACTIVE_USER_WINDOW_SECONDS=60
BUCKET_RETENTION_SECONDS=7200
DEDUP_TTL_SECONDS=86400
MAX_MESSAGE_BYTES=65536

# API / realtime delivery
BROADCAST_INTERVAL_SECONDS=1
SOCKETIO_ASYNC_MODE=gevent
# Leave blank for same-origin browser access. Set a comma-separated origin allowlist only when needed.
ALLOWED_ORIGINS=
CURRENCY=USD
LOG_LEVEL=INFO

# Optional traffic generator. The tools profile starts it only on demand.
SIMULATED_USERS=1000
TRAFFIC_THREADS=1000
EVENT_INTERVAL_SECONDS=1
RUN_DURATION_SECONDS=0
